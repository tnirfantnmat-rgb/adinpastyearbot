// =====================================================
// PAPER RETRIEVAL
// =====================================================

async function sendStoredPaper(
  env,
  chatId,
  key,
  type
) {
  let fileIds = [];

  // KV first
  const saved = await env.PAPER_FILES.get(key);

  if (saved) {
    try {
      fileIds = JSON.parse(saved);

      if (!Array.isArray(fileIds)) {
        fileIds = [saved];
      }
    } catch {
      fileIds = [saved];
    }
  }

  // Emergency old Chemistry fallback
  if (
    fileIds.length === 0 &&
    type === "question" &&
    HARDCODED_PAPERS[key]
  ) {
    fileIds = [HARDCODED_PAPERS[key]];
  }

  if (fileIds.length === 0) {
    return false;
  }

  let sent = false;

  for (const fileId of fileIds) {
    const result = await sendDocument(
      env.BOT_TOKEN,
      chatId,
      fileId
    );

    if (result) {
      sent = true;
    }
  }

  return sent;
}


// =====================================================
// TELEGRAM HELPERS
// =====================================================

function footer(text) {
  return (
    text +
    "\n\n⚠️ Disclaimer:\n" +
    "• Only Mid Sem 1 Past Year Papers & Answer Schemes are fully uploaded for now.\n" +
    "• Other Past Year sections are still incomplete.\n" +
    "• 📚 Notes and 🧠 Daily Quiz are currently under maintenance.\n\n" +
    "Any problems or missing files?\n" +
    "text me on my tele: @tuanirfan"
  );
}

async function telegram(
  token,
  method,
  payload
) {
  const response = await fetch(
    `https://api.telegram.org/bot${token}/${method}`,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    }
  );

  const result = await response.json();

  if (!result.ok) {
    console.log(
      "Telegram error:",
      method,
      result
    );
  }

  return result;
}

async function sendMessage(
  token,
  chatId,
  text
) {
  const result = await telegram(
    token,
    "sendMessage",
    {
      chat_id: chatId,
      text
    }
  );

  return result.ok === true;
}

async function sendMenu(
  token,
  chatId,
  text,
  keyboard
) {
  const result = await telegram(
    token,
    "sendMessage",
    {
      chat_id: chatId,
      text: footer(text),
      reply_markup: {
        inline_keyboard: keyboard
      }
    }
  );

  return result.ok === true;
}

