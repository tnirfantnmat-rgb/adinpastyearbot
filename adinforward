// BUTTON HANDLER
// =====================================================

async function handleCallback(callback, env) {
  const choice = callback.data;
  const chatId = callback.message.chat.id;
  const messageId = callback.message.message_id;

  await answerCallback(env.BOT_TOKEN, callback.id);

  // Return to main menu
  if (choice === "main") {
    await editMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      "🏠 EduSphere — Choose an option:",
      mainKeyboard()
    );
    return;
  }

  // Features under maintenance
  if (["notes", "daily_quiz", "leaderboard"].includes(choice)) {
    await editMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      "🛠 This feature is currently under maintenance.",
      [[{ text: "🏠 Home", callback_data: "main" }]]
    );
    return;
  }

  // Past Year Papers -> Select Semester
  if (choice === "pastyear") {
    await showSemesterMenu(env.BOT_TOKEN, chatId, messageId);
    return;
  }

  // Select Semester -> Choose Subject
  if (choice === "semester1" || choice === "semester2") {
    await showSubjectMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      choice
    );
    return;
  }

  // Choose Subject -> Choose Paper
  if (choice.startsWith("subject_")) {
    const [, semester, subject] = choice.split("_");

    await showPaperMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      semester,
      subject
    );
    return;
  }

  // Return to paper selection
  if (choice.startsWith("papermenu_")) {
    const [, semester, subject] = choice.split("_");

    await showPaperMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      semester,
      subject
    );
    return;
  }

  // Choose Paper -> Select Session
  if (choice.startsWith("paper_")) {
    const [, semester, subject, exam] = choice.split("_");

    await showYearMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      semester,
      subject,
      exam
    );
    return;
  }

  // Return to session selection
  if (choice.startsWith("sessionmenu_")) {
    const [, semester, subject, exam] = choice.split("_");

    await showYearMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      semester,
      subject,
      exam
    );
    return;
  }

  // Select Session -> Question Paper / Answer Scheme
  if (choice.startsWith("session_")) {
    const [, semester, subject, exam, year] = choice.split("_");
    const paperKey = `py_${exam}_${year}_${subject}`;

    await showFileMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      paperKey,
      semester,
      subject,
      exam
    );
    return;
  }

  // Send Question Paper
  if (choice.startsWith("question_")) {
    const key = choice.replace("question_", "");
    const success = await sendStoredPaper(
      env,
      chatId,
      key,
      "question"
    );

    if (!success) {
      await editMenu(
        env.BOT_TOKEN,
        chatId,
        messageId,
        "📂 Question Paper Not Available Yet",
        [
          [{ text: "⬅️ Back", callback_data: `fileback_${key}` }],
          [{ text: "🏠 Home", callback_data: "main" }]
        ]
      );
    }
    return;
  }

  // Send Answer Scheme
  if (choice.startsWith("answer_")) {
    const paperKey = choice.replace("answer_", "");
    const parts = paperKey.split("_");
    const answerKey = `ans_${parts[1]}_${parts[2]}_${parts[3]}`;

    const success = await sendStoredPaper(
      env,
      chatId,
      answerKey,
      "answer"
    );

    if (!success) {
      await editMenu(
        env.BOT_TOKEN,
        chatId,
        messageId,
        "📂 Answer Scheme Not Available Yet",
        [
          [
            {
              text: "⬅️ Back",
              callback_data: `fileback_${paperKey}`
            }
          ],
          [{ text: "🏠 Home", callback_data: "main" }]
        ]
      );
    }
    return;
  }

  // Return from unavailable-file message
  if (choice.startsWith("fileback_")) {
    const key = choice.replace("fileback_", "");
    const parts = key.split("_");

    const exam = parts[1];
    const year = parts[2];
    const subject = parts[3];
    const semester =
      exam === "mid1" || exam === "final1" ? "s1" : "s2";

    await showFileMenu(
      env.BOT_TOKEN,
      chatId,
      messageId,
      key,
      semester,
      subject,
      exam
    );
  }
}


