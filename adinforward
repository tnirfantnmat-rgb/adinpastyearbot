    {
      headers: {
        "Content-Type": "application/json"
      }
    }
  );
}
// TEMPORARY PAPER IMPORT
if (
  request.method === "GET" &&
  url.pathname === "/import-papers"
) {
  let imported = 0;

  for (const [key, value] of Object.entries(IMPORT_PAPERS)) {
    await env.PAPER_FILES.put(key, value);
    imported++;
  }

  return new Response(
    `✅ Imported ${imported} paper entries into PAPER_FILES KV.`
  );
}
if (request.method !== "POST") {
  return new Response(
    "EduSphere Past Year Bot is running"
  );
}

    try {
      const update = await request.json();

      // ========================================
      // PDF UPLOAD FROM STORAGE CHANNEL
      // ========================================
      const uploadMsg = update.message || update.channel_post;

      if (uploadMsg?.document) {
        await handleDocumentUpload(uploadMsg, update, env);
        return new Response("OK");
      }

      // ========================================
      // TEXT COMMAND
      // ========================================
      if (update.message?.text) {
        const message = update.message;

        if (message.chat.type !== "private") {
          return new Response("OK");
        }

        await handleTextMessage(message, env);
        return new Response("OK");
      }

      // ========================================
      // BUTTON
      // ========================================
      if (update.callback_query) {
        await handleCallback(update.callback_query, env);
        return new Response("OK");
      }

      return new Response("OK");
    } catch (error) {
      console.log("ERROR:", error);
      return new Response("OK");
    }
  }
};


// =====================================================
// TEXT COMMANDS
// =====================================================

async function handleTextMessage(message, env) {
  const chatId = message.chat.id;
  const userId = String(message.from.id);
  const text = message.text.trim();
  const lower = text.toLowerCase();

  if (lower === "/start") {
    await showMainMenu(chatId, env);
    return;
  }

  if (lower === "/id") {
    await sendMessage(
      env.BOT_TOKEN,
      chatId,
      "Your Telegram ID: " + userId
    );
    return;
  }

  if (lower === "/admin") {
    if (userId !== String(env.ADMIN_ID)) {
      await sendMessage(
        env.BOT_TOKEN,
        chatId,
        "⛔ Admin only."
      );
      return;
    }

    await sendMessage(
      env.BOT_TOKEN,
      chatId,
      "⚙️ Admin Commands\n\n" +
      "Upload PDF in storage channel:\n" +
      "/add mid1 2526 chem\n\n" +
      "Answer scheme:\n" +
      "/add mid1 2526 chem answer\n\n" +
      "Remove question paper:\n" +
      "/remove mid1 2526 chem\n\n" +
      "Remove answer scheme:\n" +
      "/remove mid1 2526 chem answer"
    );

    return;
  }

  if (lower.startsWith("/remove ")) {
    if (userId !== String(env.ADMIN_ID)) {
      await sendMessage(
        env.BOT_TOKEN,
        chatId,
        "⛔ Admin only."
      );
      return;
    }

    const parts = lower.split(/\s+/);

    if (parts.length !== 4 && parts.length !== 5) {
      await sendMessage(
        env.BOT_TOKEN,
        chatId,
        "❌ Format:\n" +
        "/remove mid1 2526 chem\n" +
        "/remove mid1 2526 chem answer"
      );
      return;
    }

    const exam = parts[1];
    const year = parts[2];
    const subject = parts[3];
    const fileType = parts[4] || "question";

    if (!isValidPaper(exam, year, subject)) {
      await sendMessage(
        env.BOT_TOKEN,
        chatId,
        "❌ Invalid exam, year or subject."
      );
      return;
    }

    const key =
      fileType === "answer"
        ? `ans_${exam}_${year}_${subject}`
        : `py_${exam}_${year}_${subject}`;

    const existing = await env.PAPER_FILES.get(key);

    if (!existing) {
      await sendMessage(
        env.BOT_TOKEN,
        chatId,
        "❌ Stored paper not found:\n" + key
      );
      return;
    }

    await env.PAPER_FILES.delete(key);

    await sendMessage(
      env.BOT_TOKEN,
      chatId,
      "🗑 Removed:\n" + key
    );

    return;
  }
}


// =====================================================
// STORAGE CHANNEL UPLOAD
// =====================================================

async function handleDocumentUpload(message, update, env) {
  // Only channel_post uploads must come from storage channel
  if (
    update.channel_post &&
    String(message.chat.id) !== String(env.STORAGE_CHANNEL_ID)
  ) {
    return;
  }

  const fileId = message.document.file_id;
  const fileName = message.document.file_name || "PDF";
  const caption = message.caption || "";
  const chatId = message.chat.id;

  if (!caption.toLowerCase().startsWith("/add ")) {
    await sendMessage(
      env.BOT_TOKEN,
      chatId,
      "FILE NAME: " + fileName +
      "\n\nFILE ID:\n" + fileId
    );

    return;
  }

  const parts = caption.trim().toLowerCase().split(/\s+/);

  if (parts.length !== 4 && parts.length !== 5) {
    await sendMessage(
      env.BOT_TOKEN,
      chatId,
      "❌ Format:\n" +
      "/add mid1 2526 chem\n" +
      "/add mid1 2526 chem answer"
    );

    return;
  }

  const exam = parts[1];
  const year = parts[2];
  const subject = parts[3];
  const fileType = parts[4] || "question";

  if (!isValidPaper(exam, year, subject)) {
    await sendMessage(
      env.BOT_TOKEN,
      chatId,
      "❌ Invalid exam, year or subject."
    );
    return;
  }

  if (
    fileType !== "question" &&
    fileType !== "answer"
  ) {
    await sendMessage(
      env.BOT_TOKEN,
      chatId,
      "❌ Last word must be 'answer' or omitted."
    );
    return;
  }

  const key =
    fileType === "answer"
      ? `ans_${exam}_${year}_${subject}`
      : `py_${exam}_${year}_${subject}`;

  const existing = await env.PAPER_FILES.get(key);

  let fileIds = [];

  if (existing) {
    try {
      fileIds = JSON.parse(existing);
      if (!Array.isArray(fileIds)) {
        fileIds = [existing];
      }
    } catch {
      fileIds = [existing];
    }
  }

  if (!fileIds.includes(fileId)) {
    fileIds.push(fileId);
  }

  await env.PAPER_FILES.put(
    key,
    JSON.stringify(fileIds)
  );

  await sendMessage(
    env.BOT_TOKEN,
    chatId,
    "✅ Paper registered!\n\n" +
    key + "\n" +
    fileName
  );
}


